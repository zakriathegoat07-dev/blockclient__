name: build
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 25
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "9.8.2"
      - name: Build
        run: |
          FILE=$(find . -name settings.gradle -not -path './.git/*' | head -n 1)
          if [ -z "$FILE" ]; then
            echo "ERROR: settings.gradle was not uploaded. Upload build.gradle, settings.gradle, gradle.properties and the src folder."
            ls -R | head -50
            exit 1
          fi
          cd "$(dirname "$FILE")"
          echo "Building in $(pwd)"
          gradle build
      - uses: actions/upload-artifact@v4
        with:
          name: blockclient-jar
          path: "**/build/libs/*.jar"
